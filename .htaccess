# Alquil-Ar — .htaccess de la raiz de htdocs en InfinityFree.
#
# InfinityFree no deja cambiar el document root a /public (todo hosting
# compartido sin acceso SSH funciona asi), asi que el proyecto entero
# (app/, system/, writable/, vendor/, .env, etc.) termina viviendo adentro
# de la carpeta publica por necesidad. Este archivo hace dos cosas:
#
#   1. Bloquea el acceso directo por URL a todo lo que no sea /public.
#   2. Manda cualquier otro pedido a public/index.php, como corresponde.

# --- 1) Bloquear archivos sueltos sensibles en esta misma carpeta ---
<FilesMatch "(^\.env$|^composer\.(json|lock)$|^spark$|^preload\.php$|^phpunit\.dist\.xml$|^\.htaccess$|^\.gitignore$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- 2) Bloquear el acceso directo a las carpetas internas del framework ---
    RewriteRule ^(app|system|writable|tests|vendor)(/|$) - [F,L]

    # --- 3) Todo lo demas se sirve a traves de public/ ---
    # El destino lleva la barra inicial (/public/$1, no public/$1): sin ella,
    # para la URL raiz "/" el resultado es una ruta relativa ambigua que en
    # InfinityFree termina en 403 (Apache intenta listar el directorio en vez
    # de ejecutar index.php, y el listado esta bloqueado por seguridad).
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>
